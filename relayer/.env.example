# TEE Oracle Relayer Configuration

# TEE pull-API endpoints — comma-separated, one per region. Prices from
# all are merged; the freshest valid signature per asset wins. A region
# being down just contributes nothing (relaying continues).
ORACLE_API_URLS=https://oracle.kaskad.live,http://kaskad-oracle-eu-west-1-alb-959293691.eu-west-1.elb.amazonaws.com

# Galleon testnet RPC
RPC_URL=https://rpc.galleon.kaskad.io

# KaskadPriceOracle contract address
ORACLE_ADDRESS=0x...

# Gas-payer private key (NOT the enclave signer — any funded wallet)
PRIVATE_KEY=0x...

# Poll interval in seconds (default: 10)
POLL_INTERVAL=10

# Relay interval in seconds (default: 15)
RELAY_INTERVAL=15
