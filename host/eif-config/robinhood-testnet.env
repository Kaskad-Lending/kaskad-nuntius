# Robinhood testnet 46630 — baked EIF identity. All values PUBLIC: contract
# addresses, RPC URLs, an owner EOA, chain ids. No secrets. PCR0 is a pure
# function of (source commit + this file); any edit here is a new PCR0 by design.
# Consumed by host/build-eif.sh, passed as --build-arg into both Dockerfiles;
# option_env! bakes them into the binaries at compile time.

# ── pontifex bridge (Dockerfile.pontifex, CID 17) ──
# KskdExit on Galleon 38836 (burn ledger). Deployer 0x44f62f5f @ nonce 0 → this
# CREATE address; freeze the Galleon deployer until DeployExit lands it here.
PONTIFEX_EXIT=0xcB6eBF49144bf7C79c679B4409f52cc7030Ee9B4
# Galleon KSKD token (reactor registry galleon_testnet). Forbidden claim
# recipient — mirrors KskdExit._exit InvalidRecipient(address(KSKD)).
PONTIFEX_KSKD=0x2d17780a59044D49FeEf0AA9cEaB1B6e3161aFf7
# KskdEntry on RH 46630 (deployer nonce 262, V2 verifier 0x6d2C4b5C); existing token retained.
PONTIFEX_ENTRY=0xD216e11D9CEb5fda6F0b797081064783964eefbD
PONTIFEX_CHAIN_ID=46630
PONTIFEX_IGRA_RPCS=https://galleon-testnet.igralabs.com:8545
PONTIFEX_VERSION=1
# Parent-oracle PCR0 allowlist. Leave EMPTY: host/build-eif.sh derives it from the
# oracle EIF it builds first and injects it here, so the bridge accepts a child key
# only from this exact oracle image. Set a value only to pin a different oracle.
PONTIFEX_ANCESTOR_PCRS=

# ── keyex genesis oracle (Dockerfile.oracle, CID 16) ──
# RH KaskadPriceOracleV2 registry (deployer nonce 261), signerCount 0 until genesis.
KEYEX_ORACLE_REGISTRY=0xd7452e94a32AC8E64bB20163873E51803EE23F1f
# drpc first: the official RPC refuses eth_call at the finalized block.
KEYEX_ORACLE_RH_RPCS=https://robinhood-testnet.drpc.org,https://rpc.testnet.chain.robinhood.com
# Governing Safe 1.4.1 on 46630 (1-of-1, testnet approver). Read live at every
# approval: the enclave accepts only owners this Safe still lists, at no less
# than its threshold.
KEYEX_ORACLE_SAFE=0xB55C38d699e165f65D9eb48a511a419FC219738B
# Owner ceiling and quorum floor: the live Safe read can only narrow the set and
# raise the bar, never the reverse. Mirrors the Safe as of 2026-10-10.
KEYEX_ORACLE_OWNERS=0x1e7b7Df37d2Df7b1FFC77DB1152bA47F9623d5d3
KEYEX_ORACLE_THRESHOLD=1
KEYEX_ORACLE_CHAIN_ID=46630
KEYEX_ORACLE_VERSION=1
KEYEX_ORACLE_ANCESTORS=
KEYEX_ORACLE_PEERS=
