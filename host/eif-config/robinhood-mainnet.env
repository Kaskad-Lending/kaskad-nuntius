# Robinhood mainnet 4663 — baked EIF identity. All values PUBLIC: contract
# addresses, RPC URLs, owner EOAs, chain ids. No secrets. PCR0 is a pure
# function of (source commit + this file); any edit here is a new PCR0 by design.
# Consumed by host/build-eif.sh, passed as --build-arg into both Dockerfiles;
# option_env! bakes them into the binaries at compile time.
#
# The pontifex addresses below are deployed (kaskad-pontifex-contracts main 2284bd8):
#   KskdExit    38833 0x5A818D42cA142483f72AE7D426E199324FEc4871 (deployer 0x047b9729…, nonce 0)
#   KskdBridged  4663 0x6ddb8541Af17DAdEA47dF41D1C13faf8Deee1902 (deployer 0x2DA5224C…, nonce 0)
#   KskdEntry    4663 0x7b1D080d2485E63791468d73418e2B262c25C402 (deployer 0x2DA5224C…, nonce 1)

# ── pontifex bridge (Dockerfile.pontifex, CID 17) ──
# KskdExit on Igra mainnet 38833 — the burn ledger the bridge reads.
PONTIFEX_EXIT=0x5A818D42cA142483f72AE7D426E199324FEc4871
# Igra mainnet KSKD (reactor registry igra_mainnet). Forbidden claim recipient —
# mirrors KskdExit._exit InvalidRecipient(address(KSKD)).
PONTIFEX_KSKD=0x16d92794F5B81d2CdEd0F0958779A410401e6435
# KskdEntry on 4663 — the claim's EIP-712 verifyingContract.
PONTIFEX_ENTRY=0x7b1D080d2485E63791468d73418e2B262c25C402
PONTIFEX_CHAIN_ID=4663
PONTIFEX_IGRA_RPCS=https://rpc.igralabs.com:8545
PONTIFEX_VERSION=1
# Parent-oracle PCR0 allowlist: the live oracle release (infra/live/eif-release.json
# oracle.pcr0, built from dcfe989). Pinned so a bridge-only build (EIF_IMAGES=pontifex)
# accepts a child key only from that image.
PONTIFEX_ANCESTOR_PCRS=5248a0d0ca1bea3044a270078286a7f788dfba98ada7069bdc4db81407e6a3a65c5be8f76e3cd299571621d71cc02296

# ── keyex genesis oracle (Dockerfile.oracle, CID 16) ──
KEYEX_ORACLE_REGISTRY=0xB4922b744cc395E05Cc962d55FA63FBab0599ec2
KEYEX_ORACLE_RH_RPCS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org
# Governing Safe 1.4.1 on 4663 (3/5), the same address as on 46630
# (createProxyWithNonce(singleton, <same initializer>, 20260922)).
KEYEX_ORACLE_SAFE=0x313807B857222278FbddF36541DE2Af5a50BdCB5
# Owner ceiling and quorum floor: the live Safe read can only narrow the set and
# raise the bar, never the reverse.
KEYEX_ORACLE_OWNERS=0x20f1a0eeEe03a811F2E9d9fF87Dca6f498843b9b,0xc0DE1337044BE1B6A85058e9227e09Bfb02420b2,0xdf5F4FD90246Ca0Da83fFF90E674CD0Ce5e13EeF,0xA780038f47C702f55Aac8F01C44E36d05eC459dD,0x2BAa832d87F82D751c1428be262993bF324eb233
KEYEX_ORACLE_THRESHOLD=3
KEYEX_ORACLE_CHAIN_ID=4663
KEYEX_ORACLE_VERSION=1
KEYEX_ORACLE_ANCESTORS=
KEYEX_ORACLE_PEERS=
