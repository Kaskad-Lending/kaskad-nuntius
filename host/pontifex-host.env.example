# /etc/kaskad/pontifex-host.env — public runtime config, NO secrets.
# Consumed by kaskad-pontifex-host.service (pontifex_host.py).

# Robinhood registries (host-supplied, untrusted; the enclave re-verifies).
KASKAD_ORACLE_REGISTRY=0x0000000000000000000000000000000000000000
KASKAD_BRIDGE_ENTRY=0x0000000000000000000000000000000000000000

# Robinhood RPC pair (both must agree at finalized inside the enclave).
KASKAD_RH_RPCS=https://robinhood-rpc.publicnode.com,https://robinhood.drpc.org

# Peer discovery + approvals.
KASKAD_ASG_NAME=kaskad-nitro-us-asg
KASKAD_AWS_REGION=us-east-1
KASKAD_EIF_BUCKET=kaskad-nitro-us-eif

# Optional tuning (defaults shown).
# PONTIFEX_RATE_LIMIT=60
# PONTIFEX_RATE_WINDOW=60
# PONTIFEX_SIGN_CACHE_TTL=60
# PONTIFEX_CONFIGURE_INTERVAL=30
# PONTIFEX_BRIDGE_TIMEOUT=10
